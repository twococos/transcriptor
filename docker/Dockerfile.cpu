# Worker del Transcriptor per al servidor (CPU). NO PROVAT: en aquest PC no hi ha Docker.
# Construir des de l'arrel del repo: docker build -f docker/Dockerfile.cpu -t transcriptor:cpu .
FROM python:3.11-slim

COPY --from=ghcr.io/astral-sh/uv:0.13.1 /uv /usr/local/bin/uv
ENV UV_LINK_MODE=copy UV_COMPILE_BYTECODE=1 UV_PROJECT_ENVIRONMENT=/opt/venv \
    TX_HOME=/dades PATH=/opt/venv/bin:$PATH

WORKDIR /app
# Primer només les dependències (capa reutilitzable), després el codi
COPY pyproject.toml uv.lock README.md ./
RUN uv sync --frozen --no-dev --no-install-project --extra cpu
COPY src ./src
RUN uv sync --frozen --no-dev --no-editable --extra cpu

# Models dins la imatge perquè el primer treball no hagi d'esperar ~2 GB de descàrregues
RUN tx models --device cpu

VOLUME /dades
# Usuari sense privilegis
RUN useradd --create-home tx && mkdir -p /dades && chown -R tx /dades
USER tx
ENTRYPOINT ["tx", "worker"]
CMD ["--api", "https://guitarreo.cat", "--token", "CANVIA-HO", "--device", "cpu"]
